# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The app connects as `reservo_app`: NOSUPERUSER, NOBYPASSRLS. Every tenant
# query is filtered by Postgres Row Level Security. The role and its password
# are created/updated by `npm run db:migrate` from this URL.
DATABASE_URL=postgres://reservo_app:reservo_app_dev_password@localhost:5433/reservo
# Privileged connection used ONLY for migrations, seeding and test setup.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/reservo
#
# Neon / Vercel: DATABASE_URL = reservo_app on the *pooled* host (-pooler),
# DATABASE_ADMIN_URL = neondb_owner on the *direct* host, both ?sslmode=require.
# Pick a long random reservo_app password: the first migration creates the role
# with it. Prepared statements are disabled automatically on "-pooler" hosts.

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Mailpit in docker-compose catches everything: http://localhost:8025)
# ---------------------------------------------------------------------------
# smtp (default) | log (print a one-line summary, send nothing) | memory (tests).
# Demo mode defaults to log.
MAIL_TRANSPORT=
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Slotsmith <no-reply@slotsmith.local>"

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to use the built-in fake provider: deposits go
# through a local checkout page and a signed fake webhook, exercising the exact
# same idempotency + outbox code path as real Stripe events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
FAKE_PAYMENTS_WEBHOOK_SECRET=dev-fake-webhook-secret

# ---------------------------------------------------------------------------
# Public demo (Vercel)
# ---------------------------------------------------------------------------
# 1 = one-click "Try the demo" sign-in, fake payments even with Stripe keys,
# emails logged (not sent), outbox drained after each request, demo banner,
# and /api/demo/reset enabled. Leave empty for a normal deployment.
DEMO_MODE=
# Bearer token for /api/cron/outbox and /api/demo/reset (Vercel Cron sends it).
# Without it both endpoints reject every call. Generate: openssl rand -hex 32
CRON_SECRET=

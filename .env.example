# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The app connects as `reservo_app`: NOSUPERUSER, NOBYPASSRLS. Every tenant
# query is filtered by Postgres Row Level Security. The role and its password
# are created/updated by `npm run db:migrate` from this URL.
DATABASE_URL=postgres://reservo_app:reservo_app_dev_password@localhost:5433/reservo
# Privileged connection used ONLY for migrations, seeding and test setup.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/reservo

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Mailpit in docker-compose catches everything: http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Reservo <no-reply@reservo.local>"

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to use the built-in fake provider: deposits go
# through a local checkout page and a signed fake webhook, exercising the exact
# same idempotency + outbox code path as real Stripe events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
FAKE_PAYMENTS_WEBHOOK_SECRET=dev-fake-webhook-secret
